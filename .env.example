# Puerto en el que se ejecuta la API
PORT=3000

# Secreto para firmar los tokens JWT
JWT_SECRET=tienda-ropa-super-secreto-cambiar

# Expiración del token (expresado en segundos o en formato jsonwebtoken)
JWT_EXPIRES_IN=1d

# Prefijo base de la API
API_PREFIX=/api

# Moneda usada en la tienda
CURRENCY=COP

# Datos de la pasarela de pago (simulación). En producción reemplazar por las
# llaves reales de la pasarela contratada (p. ej. PayU, Stripe, Wompi).
PAYMENT_GATEWAY=simulador
PAYMENT_GATEWAY_KEY=