{
  "info": {
    "_postman_id": "tienda-ropa-api-aa5-ev03",
    "name": "Tienda de Ropa - Moda Trends (AA5 EV03)",
    "description": "Colecci\u00f3n de servicios REST de la API de tienda de ropa. Proyecto formativo AA5 · Construcci\u00f3n de APIs · Luis Diossa.\n\nVar\u00edables:\n- host: base de la API (http://localhost:3000/api)\n- tokenCliente / tokenAdmin: se llenan autom\u00e1ticamente al ejecutar el paso de login correspondiente\n- productoId, pedidoId, pagoId, pqrsfId, categoriaId: se asignan en los pasos marcados con \"setup\"",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "host", "value": "http://localhost:3000/api", "type": "string" },
    { "key": "tokenCliente", "value": "", "type": "string" },
    { "key": "tokenAdmin", "value": "", "type": "string" },
    { "key": "productoId", "value": "", "type": "string" },
    { "key": "pedidoId", "value": "", "type": "string" },
    { "key": "pagoId", "value": "", "type": "string" },
    { "key": "pqrsfId", "value": "", "type": "string" },
    { "key": "categoriaId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "00 - Salud y utilidades",
      "item": [
        {
          "name": "Health - Estado de la API",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{host}}/health", "host": ["{{host}}"], "path": ["health"] }
          }
        },
        {
          "name": "M\u00e9todos de pago disponibles",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{host}}/payments/methods", "host": ["{{host}}"], "path": ["payments", "methods"] }
          }
        }
      ]
    },
    {
      "name": "01 - Autenticaci\u00f3n",
      "item": [
        {
          "name": "Login Administrador (setup tokenAdmin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.token) { pm.collectionVariables.set('tokenAdmin', json.data.token); console.log('tokenAdmin OK'); }",
                  "else { console.log('Error login admin: ', json); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@modatrends.com\",\n  \"password\": \"Admin123456\"\n}" },
            "url": { "raw": "{{host}}/auth/login", "host": ["{{host}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login Cliente (setup tokenCliente)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.token) { pm.collectionVariables.set('tokenCliente', json.data.token); console.log('tokenCliente OK'); }",
                  "else { console.log('Error login cliente: ', json); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"cliente@modatrends.com\",\n  \"password\": \"Cliente123456\"\n}" },
            "url": { "raw": "{{host}}/auth/login", "host": ["{{host}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Registrar cliente",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Nuevo Cliente\",\n  \"email\": \"nuevo@correo.com\",\n  \"password\": \"MiClave123\",\n  \"phone\": \"+57 320 000 0000\",\n  \"address\": \"Calle 1 # 1-1\"\n}"
            },
            "url": { "raw": "{{host}}/auth/register", "host": ["{{host}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Perfil autenticado (cliente)",
          "auth": {
            "type": "bearer",
            "bearer": [{ "key": "token", "value": "{{tokenCliente}}", "type": "string" }]
          },
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{host}}/auth/me", "host": ["{{host}}"], "path": ["auth", "me"] }
          }
        }
      ]
    },
    {
