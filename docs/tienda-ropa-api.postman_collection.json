      "item": [
        {
          "name": "Listar categor\u00edas",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{host}}/categories?withCount=true", "host": ["{{host}}"], "path": ["categories"] }
          }
        },
        {
          "name": "Listar productos (setup productoId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.length) { pm.collectionVariables.set('productoId', json.data[0].id); pm.collectionVariables.set('categoriaId', json.data[0].categoryId || ''); console.log('productoId =', json.data[0].id); }",
                  "else { console.log('Sin productos'); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{host}}/products?limit=1", "host": ["{{host}}"], "path": ["products"] }
          }
        },
        {
          "name": "Producto por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{host}}/products/{{productoId}}", "host": ["{{host}}"], "path": ["products", "{{productoId}}"] }
          }
        },
        {
          "name": "Productos relacionados",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{host}}/products/related/{{productoId}}", "host": ["{{host}}"], "path": ["products", "related", "{{productoId}}"] }
          }
        },
        {
          "name": "Marcas disponibles",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{host}}/products/brands", "host": ["{{host}}"], "path": ["products", "brands"] }
          }
        },
        {
          "name": "Filtrar productos",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{host}}/products?q=camiseta&sort=priceAsc&minPrice=30000&maxPrice=70000&page=1&limit=5", "host": ["{{host}}"], "path": ["products"] }
          }
        },
        {
          "name": "Ofertas vigentes",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{host}}/offers", "host": ["{{host}}"], "path": ["offers"] }
          }
        }
      ]
    },
